<Project>
  <!--
    The Local (LOReborn on this very machine) provider is a developer-only feature and must never
    ship in a public release. It is compiled in ONLY when IncludeLocalProvider=true:
      * developer machine: create the git-ignored Directory.Build.local.props containing
        <Project><PropertyGroup><IncludeLocalProvider>true</IncludeLocalProvider></PropertyGroup></Project>
      * release: scripts/build-urus-distribution.ps1 passes -p:IncludeLocalProvider=false (a global
        property always wins over this file) and refuses a payload that contains the Local assembly.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
  <PropertyGroup>
    <IncludeLocalProvider Condition="'$(IncludeLocalProvider)' == ''">false</IncludeLocalProvider>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IncludeLocalProvider)' == 'true'">
    <DefineConstants>$(DefineConstants);LOREBORN_LOCAL</DefineConstants>
  </PropertyGroup>
  <!--
    Every assembly records the mode it was compiled in. A stale developer build (compiled with the
    local provider) can never be mistaken for a public one: the attribute changes with the property,
    which forces a recompile, and the release script refuses any assembly that is not "False".
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>IncludeLocalProvider</_Parameter1>
      <_Parameter2>$(IncludeLocalProvider)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>WPF0001</WarningsNotAsErrors>
    <Deterministic>true</Deterministic>
    <!--
      Developer-build defaults only. The release version is NOT set here: the packaging script
      (scripts/build-urus-distribution.ps1) passes -p:Version, -p:AssemblyVersion, -p:FileVersion
      and -p:InformationalVersion from its -Version argument, which is the single source of truth
      for a release, and Assert-StampedVersion rejects any payload whose stamped version drifts.
      Do not bump these four values for a release; passing only -p:Version does not override the
      other three, which shipped 1.1.14 binaries still reporting 1.1.13 and looping the updater.
    -->
    <Version>1.1.13</Version>
    <AssemblyVersion>1.1.13.0</AssemblyVersion>
    <FileVersion>1.1.13.0</FileVersion>
    <InformationalVersion>1.1.13</InformationalVersion>
  </PropertyGroup>
</Project>
