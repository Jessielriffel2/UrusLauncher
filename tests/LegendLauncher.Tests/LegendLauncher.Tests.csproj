<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LegendLauncher.App\LegendLauncher.App.csproj" />
    <ProjectReference Include="..\..\src\LegendLauncher.Core\LegendLauncher.Core.csproj" />
    <ProjectReference Include="..\..\src\LegendLauncher.GameHost.Legacy\LegendLauncher.GameHost.Legacy.csproj" />
    <ProjectReference Include="..\..\src\LegendLauncher.Infrastructure\LegendLauncher.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\LegendLauncher.NetworkBridge\LegendLauncher.NetworkBridge.csproj" />
    <ProjectReference Include="..\..\src\LegendLauncher.Providers.Oas\LegendLauncher.Providers.Oas.csproj" />
    <ProjectReference Include="..\..\src\LegendLauncher.Providers.SevenWan\LegendLauncher.Providers.SevenWan.csproj" />
    <ProjectReference Include="..\..\src\LegendLauncher.Providers.Elarionis\LegendLauncher.Providers.Elarionis.csproj" />
    <ProjectReference Include="..\..\src\LegendLauncher.Providers.SwordOnline\LegendLauncher.Providers.SwordOnline.csproj" />
  </ItemGroup>

  <!-- Developer-only provider and its tests: compiled only when IncludeLocalProvider=true. -->
  <ItemGroup Condition="'$(IncludeLocalProvider)' == 'true'">
    <ProjectReference Include="..\..\src\LegendLauncher.Providers.Local\LegendLauncher.Providers.Local.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeLocalProvider)' != 'true'">
    <Compile Remove="Local\**" />
  </ItemGroup>

</Project>
