<UserControl x:Class="LegendLauncher.App.Views.Game.GameDisplayControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:loc="clr-namespace:LegendLauncher.App.Localization"
             Focusable="False">
    <UserControl.Resources>
        <!-- DirectX / Compatible switch: same height and frame as the colors control; lit (accent) while DirectX is on. -->
        <Style x:Key="WindowModeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,0,12,0" />
            <Setter Property="Background" Value="#7A0B1A26" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Colors and zoom only act in the Compatible mode: greyed out (tooltip still shown) while DirectX is on. -->
        <Style x:Key="CompatibleOnlyBorderStyle" TargetType="Border">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompatibleOnlyComboStyle" TargetType="ComboBox" BasedOn="{StaticResource LanguageComboStyle}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- How the game is shown, shared by every open session (DataContext: MainWindowViewModel, inherited from the game toolbar). -->
    <StackPanel x:Name="DisplayControlsGroup" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Modo de desenho: DirectX (placa de video, mais fluido) ou Compativel (com Cores e Zoom). Vale para as proximas abas. -->
        <ToggleButton x:Name="WindowModeToggle"
                      Style="{StaticResource WindowModeToggleStyle}"
                      IsChecked="{Binding Workspace.IsDirectXMode, Mode=TwoWay}"
                      ToolTip="{loc:Localize Workspace_WindowModeTooltip}"
                      AutomationProperties.Name="{loc:Localize Workspace_WindowModeAutomation}">
            <StackPanel Orientation="Horizontal">
                <Path x:Name="WindowModeIcon"
                      Data="M 7,0 L 0,8 L 4.5,8 L 3,14 L 10,5.5 L 5.5,5.5 Z"
                      Width="10" Height="14" Stretch="Fill"
                      VerticalAlignment="Center" Margin="0,0,7,0">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Workspace.IsDirectXMode}" Value="True">
                                    <Setter Property="Fill" Value="#F3C766" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock x:Name="WindowModeLabel" Text="{Binding Workspace.WindowModeLabel}" VerticalAlignment="Center" />
            </StackPanel>
        </ToggleButton>
        <!-- Saturacao das cores do jogo: um valor para todas as contas (filtro aplicado no GameHost, so no modo Compativel). -->
        <Border x:Name="ColorSaturationControl"
                Style="{StaticResource CompatibleOnlyBorderStyle}"
                IsEnabled="{Binding Workspace.AreCompatibleOnlyControlsEnabled}"
                Margin="0,0,8,0"
                Padding="10,0,12,0"
                Height="34"
                CornerRadius="8"
                Background="#7A0B1A26"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                ToolTip="{Binding Workspace.ColorSaturationToolTip}"
                MouseLeftButtonDown="ColorSaturationControl_OnMouseLeftButtonDown"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="14"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBlock x:Name="ColorSaturationLabel" Text="{loc:Localize Workspace_ColorSaturationLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Slider x:Name="ColorSaturationSlider"
                        Width="110"
                        VerticalAlignment="Center"
                        Style="{StaticResource ColorSaturationSliderStyle}"
                        Value="{Binding Workspace.ColorSaturation, Mode=TwoWay}"
                        AutomationProperties.Name="{loc:Localize Workspace_ColorSaturationAutomation}" />
                <TextBlock Text="{Binding Workspace.ColorSaturationText}" Width="36" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>
        <!-- Zoom do jogo (1.1.25): Automatico acompanha a escala do Windows (TV, 4K); cada GameHost amplia a propria sessao (so no modo Compativel). -->
        <ComboBox x:Name="WorkspaceZoomSelector"
                  Width="172"
                  Margin="0,0,8,0"
                  Style="{StaticResource CompatibleOnlyComboStyle}"
                  IsEnabled="{Binding Workspace.AreCompatibleOnlyControlsEnabled}"
                  ItemsSource="{Binding Workspace.ZoomOptions}"
                  SelectedItem="{Binding Workspace.SelectedZoomOption, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName"
                  PreviewMouseLeftButtonDown="ComboBoxSelector_OnPreviewMouseLeftButtonDown"
                  PreviewKeyDown="ComboBoxSelector_OnPreviewKeyDown"
                  ToolTip="{Binding Workspace.ZoomToolTip}"
                  AutomationProperties.Name="{loc:Localize Workspace_ZoomAutomation}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
    </StackPanel>
</UserControl>
